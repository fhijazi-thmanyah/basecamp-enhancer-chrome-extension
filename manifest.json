{
  "manifest_version": 3,
  "name": "Basecamp Enhancer",
  "version": "1.12.5",
  "description": "Basecamp quality-of-life: relative timestamps, RTL fix, a Google-Chat–style hover bar with one-click emoji reactions plus the full action menu, and a Claude Code launcher that spawns an HQ worker to handle/watch the current conversation. Toggle each from the toolbar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8377/*",
    "http://localhost:8377/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/claudecode.png"
      ],
      "matches": [
        "https://app.basecamp.com/*",
        "https://3.basecamp.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Basecamp Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.basecamp.com/*",
        "https://3.basecamp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
